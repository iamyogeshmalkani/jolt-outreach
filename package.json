{
  "name": "jolt-outreach-ui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "setup": "node scripts/py.mjs setup",
    "login": "node scripts/py.mjs --login",
    "find": "node scripts/py.mjs",
    "videos": "node scripts/py.mjs --videos",
    "watch": "node scripts/py.mjs --videos --every 60",
    "selftest": "node scripts/py.mjs --selftest",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fontsource-variable/hanken-grotesk": "^5.3.0",
    "@fontsource-variable/newsreader": "^5.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
