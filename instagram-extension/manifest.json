{
  "manifest_version": 3,
  "name": "Jolt Instagram finder",
  "version": "1.2.1",
  "description": "Finds recent, popular Instagram reels on your keywords, plus the comments on them about screen time and digital habits, and lists them on your Jolt outreach page.",
  "permissions": [
    "storage",
    "alarms",
    "scripting"
  ],
  "host_permissions": [
    "https://www.instagram.com/*",
    "https://api.github.com/*",
    "https://api.anthropic.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Jolt Instagram finder"
  },
  "options_page": "options.html"
}
