{
  "manifest_version": 3,
  "name": "Jolt finder",
  "version": "3.2.0",
  "description": "Finds recent, popular TikTok videos on your topics, plus the comments on them about screen time, brain rot and similar, and lists them on your Jolt outreach page.",
  "permissions": [
    "storage",
    "alarms",
    "scripting"
  ],
  "host_permissions": [
    "https://www.tiktok.com/*",
    "https://api.github.com/*",
    "https://api.anthropic.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Jolt finder"
  },
  "options_page": "options.html"
}
